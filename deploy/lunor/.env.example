# Copy to deploy/lunor/.env; never commit the real .env.
# LUNOR_DOMAIN and PUBLIC_BASE_URL must refer to the same public HTTPS host.
# Example for Toolpick; create the DNS records on your DNS provider.
LUNOR_DOMAIN=share.toolpick.id.vn
PUBLIC_BASE_URL=https://share.toolpick.id.vn

# Must resolve DIRECTLY to the VPS IPv4 (DNS-only; not Cloudflare-proxied).
STUN_URLS=stun:stun.toolpick.id.vn:3478

# REQUIRED: set a unique secret, e.g. "openssl rand -hex 24".
SITE_ACCESS_PASSWORD=

# Optional SFU forwarding after UDP 7882 and public IPv4 are verified.
# Set both lines together, using your REAL IPv4, not the example:
# SFU_UDP_PORT=7882
# SFU_PUBLIC_IP=203.0.113.10
